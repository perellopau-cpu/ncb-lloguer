---
import type { Idioma } from '../i18n/idiomes';
import { t } from '../i18n/textos';
interface Props { l: Idioma }
const tx = t(Astro.props.l).inclou;
const punts = tx.punts;
---
<section aria-label={tx.aria} class="contenidor inclou">
  <ul>
    {punts.map((p) => (
      <li>
        <strong>{p.titol}</strong>
        <span>{p.text}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .inclou { padding-bottom: 56px; }
  ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;
  }
  li { border-top: 2px solid var(--blau); padding-top: 14px; display: flex; flex-direction: column; gap: 4px; }
  strong { font-size: 16px; font-weight: 600; }
  span { font-size: 14px; color: var(--gris-text); line-height: 1.5; }
  @media (min-width: 760px) { .inclou { padding-bottom: 72px; } }
</style>
