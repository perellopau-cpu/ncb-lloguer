---
import { contacte, enllacWhatsapp, webOficial } from '../data/site';
import { idiomes as codis, infoIdiomes, rutaInici, type Idioma, type Alternatives } from '../i18n/idiomes';
import { t } from '../i18n/textos';

interface Props { l: Idioma; alternatives: Alternatives }
const { l, alternatives } = Astro.props;
const tx = t(l).general;

// El selector porta a la mateixa pàgina en l'altre idioma.
const idiomes = codis.map((codi) => ({
  codi, nom: infoIdiomes[codi].nom, href: alternatives[codi], actiu: codi === l,
}));

const menu = [
  { text: tx.menu.lloguer, href: `${rutaInici(l)}#flota`, actiu: true },
  { text: tx.menu.venda, href: webOficial, actiu: false },
  { text: tx.menu.serveis, href: webOficial, actiu: false },
  { text: tx.menu.empresa, href: webOficial, actiu: false },
];
---
<header class="capcalera">
  <div class="contenidor capcalera__fila">
    <a href={rutaInici(l)} class="capcalera__logo" aria-label={tx.iniciAria}>
      <img src="/logo-ncb-blanc.png" alt="NCB Nàutica Costa Brava" width="145" height="54" />
    </a>

    <nav aria-label={tx.menuAria} class="capcalera__menu">
      {menu.map((m) => (
        <a href={m.href} aria-current={m.actiu ? 'page' : undefined} class:list={[{ actiu: m.actiu }]}>
          {m.text}
        </a>
      ))}
    </nav>

    <div class="capcalera__dreta">
      <div class="idiomes" aria-label={tx.idiomaAria}>
        {idiomes.map((i) => (
          <a href={i.href} hreflang={i.codi} lang={i.codi} aria-label={i.nom}
             aria-current={i.actiu ? 'page' : undefined} class:list={['idioma', { actiu: i.actiu }]}>
            <span>{i.codi.toUpperCase()}</span>
            {i.codi === 'ca' && (
              <svg viewBox="0 0 18 12" width="20" height="13" aria-hidden="true"><rect width="18" height="12" fill="#FCDD09"/><rect y="1.333" width="18" height="1.333" fill="#DA121A"/><rect y="4" width="18" height="1.333" fill="#DA121A"/><rect y="6.667" width="18" height="1.333" fill="#DA121A"/><rect y="9.333" width="18" height="1.333" fill="#DA121A"/></svg>
            )}
            {i.codi === 'es' && (
              <svg viewBox="0 0 18 12" width="20" height="13" aria-hidden="true"><rect width="18" height="12" fill="#AA151B"/><rect y="3" width="18" height="6" fill="#F1BF00"/></svg>
            )}
            {i.codi === 'en' && (
              <svg viewBox="0 0 60 30" width="20" height="13" aria-hidden="true" preserveAspectRatio="none"><rect width="60" height="30" fill="#012169"/><polygon points="0,0 6.7,0 60,26.6 60,30 53.3,30 0,3.4" fill="#fff"/><polygon points="60,0 53.3,0 0,26.6 0,30 6.7,30 60,3.4" fill="#fff"/><polygon points="0,0 3.4,0 60,28.3 60,30 56.6,30 0,1.7" fill="#C8102E"/><polygon points="60,0 56.6,0 0,28.3 0,30 3.4,30 60,1.7" fill="#C8102E"/><rect x="25" width="10" height="30" fill="#fff"/><rect y="10" width="60" height="10" fill="#fff"/><rect x="27" width="6" height="30" fill="#C8102E"/><rect y="12" width="60" height="6" fill="#C8102E"/></svg>
            )}
            {i.codi === 'fr' && (
              <svg viewBox="0 0 18 12" width="20" height="13" aria-hidden="true"><rect width="6" height="12" fill="#0055A4"/><rect x="6" width="6" height="12" fill="#fff"/><rect x="12" width="6" height="12" fill="#EF4135"/></svg>
            )}
          </a>
        ))}
      </div>

      <div class="capcalera__reserva">
        <a class="boto boto--groc boto--mitja" href={enllacWhatsapp()}>{tx.reservaWhatsapp}</a>
        <a class="capcalera__tel" href={contacte.telefonLink}>{tx.trucans(contacte.telefon)}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .capcalera { background: var(--blau); }
  .capcalera__fila {
    padding-top: 12px; padding-bottom: 12px;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: "logo dreta" "menu menu";
    align-items: center; gap: 12px 16px;
  }
  .capcalera__logo { grid-area: logo; display: flex; }
  .capcalera__logo img { height: 44px; width: auto; }
  .capcalera__menu {
    grid-area: menu; display: flex; gap: 22px; font-size: 15px; font-weight: 500;
    overflow-x: auto; scrollbar-width: none; padding-top: 4px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .capcalera__menu a {
    color: var(--blanc); text-decoration: none; padding: 8px 0 3px;
    border-bottom: 2px solid transparent; white-space: nowrap;
  }
  .capcalera__menu a.actiu, .capcalera__menu a:hover { border-bottom-color: var(--groc); }
  .capcalera__dreta {
    grid-area: dreta; justify-self: end;
    display: flex; align-items: center; gap: 16px;
  }
  .idiomes { display: flex; gap: 10px; font-size: 12px; font-weight: 600; }
  .idioma {
    color: var(--blau-clar); text-decoration: none;
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    min-width: 28px; padding: 2px 0;
  }
  .idioma.actiu, .idioma:hover { color: var(--blanc); }
  .idioma svg { border-radius: 2px; }
  .capcalera__reserva { display: none; flex-direction: column; align-items: center; gap: 6px; }
  .capcalera__tel { color: var(--blanc); font-size: 12px; font-weight: 500; text-decoration: none; }
  .capcalera__tel:hover { color: var(--groc); }

  /* Tauleta: apareix el botó de WhatsApp a la capçalera */
  @media (min-width: 760px) {
    .capcalera__reserva { display: flex; }
    .capcalera__dreta { gap: 24px; }
  }

  /* Ordinador: tot en una sola fila, com a la maqueta */
  @media (min-width: 1024px) {
    .capcalera__fila {
      padding-top: 16px; padding-bottom: 16px;
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "logo menu dreta";
      gap: 20px;
    }
    .capcalera__logo img { height: 54px; }
    .capcalera__menu {
      justify-content: center; gap: 28px; border-top: none; padding-top: 0;
    }
    .capcalera__menu a { padding: 0 0 3px; }
  }
</style>
